# Copy this file to keystore.properties (git-ignored) and fill it in to sign release builds with your own key.
# Without keystore.properties, release builds are signed with the debug key instead.
#
# Create a key once, and back the .jks file up somewhere safe: losing it means you can't update an
# installed app.
#   keytool -genkeypair -v -keystore golddigger-release.jks -alias golddigger -keyalg RSA -keysize 2048 -validity 10000
storeFile=golddigger-release.jks
storePassword=change-me
keyAlias=golddigger
keyPassword=change-me
