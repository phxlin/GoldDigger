<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft drop shadow -->
    <path
        android:pathData="M28,58 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0"
        android:fillColor="#33000000" />

    <!-- coin body -->
    <path android:pathData="M27,54 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="43" android:centerY="41"
                android:gradientRadius="50"
                android:startColor="#FFEFB8"
                android:endColor="#D49E22" />
        </aapt:attr>
    </path>

    <!-- inner rim -->
    <path
        android:pathData="M28.6,54 a25.4,25.4 0 1,0 50.8,0 a25.4,25.4 0 1,0 -50.8,0"
        android:strokeColor="#AC7B13"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- rising trend line -->
    <path
        android:pathData="M42.68,61.27 L50.6,52.16 L58.88,58.14 L70.84,42.5"
        android:strokeColor="#0B5433"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- arrowhead -->
    <path
        android:pathData="M70.84,42.5 L59.8,42.5 M70.84,42.5 L70.84,53.54"
        android:strokeColor="#0B5433"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- shovel handle bar across the tail of the line -->
    <path
        android:pathData="M36.52,58.51 L46.09,66.97"
        android:strokeColor="#0B5433"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
